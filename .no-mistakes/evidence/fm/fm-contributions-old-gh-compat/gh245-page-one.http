il, err\n \t}\n+\n+\tgitClient := opts.GitClient\n+\tif ucc, err := gitClient.UncommittedChangeCount(context.Background()); err == nil && ucc > 0 {\n+\t\tfmt.Fprintf(opts.IO.ErrOut, \"Warning: %s\\n\", text.Pluralize(ucc, \"uncommitted change\"))\n+\t}\n+\n+\t// Resolve base repo\n \trepoContext, err := ghContext.ResolveRemotesToRepos(remotes, client, opts.RepoOverride)\n \tif err != nil {\n \t\treturn nil, err\n \t}\n \n-\tvar baseRepo *api.Repository\n+\tvar targetBaseRepo *api.Repository","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.github.com/users/BagToad","html_url":"https://github.com/BagToad","followers_url":"https://api.github.com/users/BagToad/followers","following_url":"https://api.github.com/users/BagToad/following{/other_user}","gists_url":"https://api.github.com/users/BagToad/gists{/gist_id}","starred_url":"https://api.github.com/users/BagToad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"I think you're asking \"why did you propose changing this from `targetBaseRepo` to `baseRepo`\"?\r\n\r\nI'm not super happy with the `target` naming here; it could be better. I wanted to differentiate between this being the arg we pass into `ParsePRRefs` and the `PrRefs.BaseRepo` that we will eventually use.\r\n\r\nSo, it's like the \"initial\" base repo, and likely the eventual base repo, but ultimately we're going to use whatever `ParsePRRefs` gives us.","created_at":"2025-03-06T20:17:42Z","updated_at":"2025-03-06T20:17:43Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983995877","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983995877"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983995877"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983995877/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":575,"side":"RIGHT","in_reply_to_id":1983746943,"author_association":"MEMBER","original_position":206,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983997239","pull_request_review_id":2665527179,"id":1983997239,"node_id":"PRRC_kwDODKw3uc52QWU3","diff_hunk":"@@ -638,19 +560,26 @@ func NewCreateContext(opts *CreateOptions) (*CreateContext, error) {\n \tif err != nil {\n \t\treturn nil, err\n \t}\n+\n+\tgitClient := opts.GitClient\n+\tif ucc, err := gitClient.UncommittedChangeCount(context.Background()); err == nil && ucc > 0 {\n+\t\tfmt.Fprintf(opts.IO.ErrOut, \"Warning: %s\\n\", text.Pluralize(ucc, \"uncommitted change\"))\n+\t}\n+\n+\t// Resolve base repo\n \trepoContext, err := ghContext.ResolveRemotesToRepos(remotes, client, opts.RepoOverride)\n \tif err != nil {\n \t\treturn nil, err\n \t}\n \n-\tvar baseRepo *api.Repository\n+\tvar targetBaseRepo *api.Repository","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.c