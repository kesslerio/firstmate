 targetBaseRepo.DefaultBranchRef.Name\n \t}\n-\tif headBranch == baseBranch && headRepo != nil && ghrepo.IsSame(baseRepo, headRepo) {\n+\tif prRefs.BranchName == baseBranch && prRefs.HeadRepo != nil && ghrepo.IsSame(prRefs.BaseRepo, prRefs.HeadRepo) {","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.github.com/users/BagToad","html_url":"https://github.com/BagToad","followers_url":"https://api.github.com/users/BagToad/followers","following_url":"https://api.github.com/users/BagToad/following{/other_user}","gists_url":"https://api.github.com/users/BagToad/gists{/gist_id}","starred_url":"https://api.github.com/users/BagToad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"Also, as I'm going back to this, I think the error message has room for improvement. This conditional is about targeting itself, but it is not immediately clear from the conditional or the error message. A more verbose option to consider later: `headrepo and base repo cannot be the same when head branch and base branch are the same`\r\n\r\nI don't want to do this here but making a note of it for that new issue later. ","created_at":"2025-03-10T16:20:32Z","updated_at":"2025-03-10T16:20:33Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1987627428","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self"