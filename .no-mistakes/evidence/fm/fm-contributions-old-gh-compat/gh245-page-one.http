riginal_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"jtmcg","id":5891697,"node_id":"MDQ6VXNlcjU4OTE2OTc=","avatar_url":"https://avatars.githubusercontent.com/u/5891697?v=4","gravatar_id":"","url":"https://api.github.com/users/jtmcg","html_url":"https://github.com/jtmcg","followers_url":"https://api.github.com/users/jtmcg/followers","following_url":"https://api.github.com/users/jtmcg/following{/other_user}","gists_url":"https://api.github.com/users/jtmcg/gists{/gist_id}","starred_url":"https://api.github.com/users/jtmcg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jtmcg/subscriptions","organizations_url":"https://api.github.com/users/jtmcg/orgs","repos_url":"https://api.github.com/users/jtmcg/repos","events_url":"https://api.github.com/users/jtmcg/events{/privacy}","received_events_url":"https://api.github.com/users/jtmcg/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"I used `UPSTREAMOWNER` and `ORIGINOWNER` in the [Finder tests](https://github.com/cli/cli/blob/fc19ff321a4b7f4198f788f08da20249c7950fbd/pkg/cmd/pr/shared/finder_test.go#L31-L61). Notably, I left a TODO about perhaps making them more reusable, i.e. establish the nomenclature.\r\n\r\nAs for bullet 2, @andyfeller, I'm not sure we currently support Organization forks, right? So all of these would be user forks. As for the `monalisa` owner, I think this is commonly used but it isn't established nomenclature and was a MAJOR cause of confusion for me while refactoring the Finder. That's why I settled on `UPSTREAMOWNER` and `ORIGINOWNER`. ","created_at":"2025-03-06T17:54:48Z","updated_at":"2025-03-06T17:56:27Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983819415","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983819415"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983819415"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983819415/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":1724,"start_side":"RIGHT","line":null,"original_line":1731,"side":"RIGHT","in_reply_to_id":1983585639,"author_association":"CONTRIBUTOR","original_position":382,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983820139","pull_request_review_id":2665071223,"id":1983820139,"node_id":"PRRC_kwDODKw3uc52PrFr","diff_hunk":"@@ -1777,19 +1740,27 @@ func Test_generateCompareURL(t *testing.T) {\n \t\t\t\t    - See https://github.com/golang/go/issues/27559.\n \t\t\t*/\n \t\t\tctx: CreateContext{\n-\t\t\t\tBaseRepo:        api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER\"}}, \"github.com\"),\n-\t\t\t\tBaseBranch:      \"main/trunk\",\n-\t\t\t\tHeadBranchLabel: \"owner:!$&'()+,;=@\",\n+\t\t\t\tPrRefs: shared.PullRequestRefs{\n+\t\t\t\t\tBaseRepo:   api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER-UPSTREAM\"}}, \"github.com\"),\n+\t\t\t\t\tHeadRepo:   api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER\"}}, \"github.com\"),\n+\t\t\t\t\tBranchName: \"!$&'()+,;=@\",\n+\t\t\t\t},\n+\t\t\t\tBaseBranch: \"main/trunk\",\n+\t\t\t\t//TODO check this\n+\t\t\t\t// HeadBranchLabel: \"owner:!$&'()+,;=@\",","path":"pkg/cmd/pr/create/create_test.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"jtmcg","id":5891697,"node_id":"MDQ6VXNlcjU4OTE2OTc=","avatar_url":"https://avatars.githubusercontent.com/u/5891697?v=4","gravatar_id":"","url":"https://api.github.com/users/jtmcg","html_url":"https://github.com/jtmcg","followers_url":"https://api.github.com/users/jtmcg/followers","following_url":"https://api.github.com/users/jtmcg/following{/other_user}","gists_url":"https://api.github.com/users/jtmcg/gists{/gist_id}","starred_url":"https://api.github.com/users/jtmcg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jtmcg/subscriptions","organizations_url":"https://api.github.com/users/jtmcg/orgs","repos_url":"https://api.github.com/users/jtmcg/repos","events_url":"https://api.github.com/users/jtmcg/events{/privacy}","received_events_url":"https://api.github.com/users/jtmcg/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"What's this?","created_at":"2025-03-06T17:55:19Z","updated_at":"2025-03-06T17:56:27Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983820139","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983820139"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983820139"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983820139/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":1749,"start_side":"RIGHT","line":null,"original_line":1750,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":400,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983959021","pull_request_review_id":2665463138,"id":1983959021,"node_id":"PRRC_kwDODKw3uc52QM_t","diff_hunk":"@@ -0,0 +1,46 @@\n+skip 'it creates a fork owned by the user running the test'","path":"acceptance/testdata/pr/pr-create-respects-branch-pushremote.txtar","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.github.com/users/BagToad","html_url":"https://github.com/BagToad","followers_url":"https://api.github.com/users/BagToad/followers","following_url":"https://api.github.com/users/BagToad/following{/other_user}","gists_url":"https://api.github.com/users/BagToad/gists{/gist_id}","starred_url":"https://api.github.com/users/BagToad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"@andyfeller I'm struggling to answer this, I don't think I understand the question, sorry. I may answer it wrong below because of this lack of clarity on my part.\r\n\r\nAre you asking why I care if the fork is owned by a user account, and why that would cause me to skip the test?\r\n\r\nAnswer to that: I'm quite strongly opposed to acceptance tests altering _absolutely anything_ to do with your personal account (or whatever user owns the auth token) without the user needing to opt in explicitly.\r\n\r\nThese tests need to create a cross org/owner fork because we do not currently support same org forks. In lieu of a separate acceptance test org var, I opt to simply leverage the account which owns the auth token.","created_at":"2025-03-06T19:45:46Z","updated_at":"2025-03-06T20:47:44Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983959021","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983959021"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983959021"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983959021/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","in_reply_to_id":1983478028,"author_association":"MEMBER","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983961601","pull_request_review_id":2665467638,"id":1983961601,"node_id":"PRRC_kwDODKw3uc52QNoB","diff_hunk":"@@ -0,0 +1,46 @@\n+skip 'it creates a fork owned by the user running the test'","path":"acceptance/testdata/pr/pr-create-respects-branch-pushremote.txtar","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.github.com/users/BagToad","html_url":"https://github.com/BagToad","followers_url":"https://api.github.com/users/BagToad/followers","following_url":"https://api.github.com/users/BagToad/following{/other_user}","gists_url":"https://api.github.com/users/BagToad/gists{/gist_id}","starred_url":"https://api.github.com/users/BagToad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"> how this relates to the acceptance testing results?\r\n\r\nI'm also confused by this. Are you asking if the acceptance test results listed in the PR body are running the tests or skipping them?\r\n\r\nIf so, the answer is yes, I commented out the `skip` line to produce the results in the PR body. This is why they are listed as `PASS`:\r\n\r\n```\r\n    --- PASS: TestPullRequests/pr-create-respects-simple-pushdefault (7.51s)\r\n    --- PASS: TestPullRequests/pr-create-respects-push-destination (15.02s)\r\n    --- PASS: TestPullRequests/pr-create-respects-branch-pushremote (14.77s)\r\n```\r\n\r\nWhen the `skip` is present, they are listed as `SKIP`, like this:\r\n\r\n```\r\n    --- SKIP: TestPullRequests/pr-create-respects-remote-pushdefault (0.01s)\r\n    --- SKIP: TestPullRequests/pr-create-respects-remote-colon-branch-syntax (0.01s)\r\n    --- SKIP: TestPullRequests/pr-create-respects-push-destination (0.01s)\r\n    --- SKIP: TestPullRequests/pr-create-respects-branch-pushremote (0.01s)\r\n```","created_at":"2025-03-06T19:48:02Z","updated_at":"2025-03-06T19:48:02Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983961601","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983961601"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983961601"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983961601/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","in_reply_to_id":1983478028,"author_association":"MEMBER","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983963816","pull_request_review_id":2665471105,"id":1983963816,"node_id":"PRRC_kwDODKw3uc52QOKo","diff_hunk":"@@ -0,0 +1,51 @@\n+skip 'it creates a fork owned by the user running the test'\n+\n+# Setup environment variables used for testscript\n+env REPO=${SCRIPT_NAME}-${RANDOM_STRING}\n+env FORK=${REPO}-fork\n+\n+# Use gh as a credential helper\n+exec gh auth setup-git\n+\n+# Get the current username for the fork owner\n+exec gh api user --jq .login\n+stdout2env USER\n+\n+# Create a repository to act as upstream with a file so it has a default branch\n+exec gh repo create ${ORG}/${REPO} --add-readme --private\n+\n+# Defer repo cleanup of upstream\n+defer gh repo delete --yes ${ORG}/${REPO}\n+\n+# Create a user fork of repository. This will be owned by USER.\n+exec gh repo fork ${ORG}/${REPO} --fork-name ${FORK}\n+\n+# Defer repo cleanup of fork\n+defer gh repo delete --yes ${USER}/${FORK}\n+sleep 5\n+exec gh repo view ${USER}/${FORK} --json id --jq '.id'\n+stdout2env FORK_ID\n+\n+# Clone the repo\n+exec gh repo clone ${USER}/${FORK}\n+cd ${FORK}\n+\n+# Configure default push behavior so local and remote branches will be the same\n+exec git config push.default current","path":"acceptance/testdata/pr/pr-create-respects-push-destination.txtar","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.github.com/users/BagToad","html_url":"https://github.com/BagToad","followers_url":"https://api.github.com/users/BagToad/followers","following_url":"https://api.github.com/users/BagToad/following{/other_user}","gists_url":"https://api.github.com/users/BagToad/gists{/gist_id}","starred_url":"https://api.github.com/users/BagToad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"I'm a bit confused, sorry. Can you clarify if you are asking a if the current implementation works or if your suggestion works? Can you also please clarify if you tested your proposed solution and what the benefits are with using it? Are you suggesting that the current implementation actually _doesn't_ set this config properly?\r\n\r\nNote: I'm not off-hand familiar with git config syntax, but I'm assuming you have some knowledge that I don't and I'd very much appreciate you sharing more of your thoughts here 🙏 ","created_at":"2025-03-06T19:49:50Z","updated_at":"2025-03-06T19:50:58Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983963816","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983963816"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983963816"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983963816/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":36,"original_line":36,"side":"RIGHT","in_reply_to_id":1983497480,"author_association":"MEMBER","original_position":34,"position":36,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983965674","pull_request_review_id":2665474283,"id":1983965674,"node_id":"PRRC_kwDODKw3uc52QOnq","diff_hunk":"@@ -0,0 +1,46 @@\n+skip 'it creates a fork owned by the user running the test'\n+\n+# Setup environment variables used for testscript\n+env REPO=${SCRIPT_NAME}-${RANDOM_STRING}\n+env FORK=${REPO}-fork\n+\n+# Use gh as a credential helper\n+exec gh auth setup-git\n+\n+# Get the current username for the fork owner\n+exec gh api user --jq .login\n+stdout2env USER\n+\n+# Create a repository to act as upstream with a file so it has a default branch\n+exec gh repo create ${ORG}/${REPO} --add-readme --private\n+\n+# Defer repo cleanup of upstream\n+defer gh repo delete --yes ${ORG}/${REPO}\n+\n+# Create a user fork of repository. This will be owned by USER.\n+exec gh repo fork ${ORG}/${REPO} --fork-name ${FORK}\n+\n+# Defer repo cleanup of fork\n+defer gh repo delete --yes ${USER}/${FORK}\n+sleep 5\n+exec gh repo view ${USER}/${FORK} --json id --jq '.id'\n+stdout2env FORK_ID\n+\n+# Clone the repo\n+exec gh repo clone ${USER}/${FORK}\n+cd ${FORK}\n+\n+# Prepare a branch where changes are pulled from the upstream default branch but pushed to fork\n+exec git checkout -b feature-branch upstream/main\n+exec git config branch.feature-branch.pushRemote origin","path":"acceptance/testdata/pr/pr-create-respects-branch-pushremote.txtar","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.github.com/users/BagToad","html_url":"https://github.com/BagToad","followers_url":"https://api.github.com/users/BagToad/followers","following_url":"https://api.github.com/users/BagToad/following{/other_user}","gists_url":"https://api.github.com/users/BagToad/gists{/gist_id}","starred_url":"https://api.github.com/users/BagToad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":t