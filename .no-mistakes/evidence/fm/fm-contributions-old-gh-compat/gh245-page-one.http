/jtmcg","followers_url":"https://api.github.com/users/jtmcg/followers","following_url":"https://api.github.com/users/jtmcg/following{/other_user}","gists_url":"https://api.github.com/users/jtmcg/gists{/gist_id}","starred_url":"https://api.github.com/users/jtmcg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jtmcg/subscriptions","organizations_url":"https://api.github.com/users/jtmcg/orgs","repos_url":"https://api.github.com/users/jtmcg/repos","events_url":"https://api.github.com/users/jtmcg/events{/privacy}","received_events_url":"https://api.github.com/users/jtmcg/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"My spidey senses are tingling, here, that we already have everything we need in PRRefs to determine if we're trying to merge from a branch with the same name as the default... This `.MergeBase` and `.DefaultBranchRef.Name` seem like something we should already have confidence about... \r\n\r\nWhat am I missing? ","created_at":"2025-03-06T17:43:42Z","updated_at":"2025-03-06T17:56:27Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983804713","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983804713"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983804713"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983804713/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":739,"start_side":"RIGHT","line":null,"original_line":744,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":411,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983805485","pull_request_review_id":2665071223,"id":1983805485,"node_id":"PRRC_kwDO