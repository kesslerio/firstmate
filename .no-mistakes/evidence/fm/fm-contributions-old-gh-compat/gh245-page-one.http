-yes ${ORG}/${REPO}\n+\n+# Create a user fork of repository. This will be owned by USER.\n+exec gh repo fork ${ORG}/${REPO} --fork-name ${FORK}\n+\n+# Defer repo cleanup of fork\n+defer gh repo delete --yes ${USER}/${FORK}\n+sleep 5\n+exec gh repo view ${USER}/${FORK} --json id --jq '.id'\n+stdout2env FORK_ID\n+\n+# Clone the repo\n+exec gh repo clone ${USER}/${FORK}\n+cd ${FORK}\n+\n+# Prepare a branch where changes are pulled from the upstream default branch but pushed to fork\n+exec git checkout -b feature-branch upstream/main\n+exec git config remote.pushDefault origin","path":"acceptance/testdata/pr/pr-create-respects-remote-pushdefault.txtar","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.github.com/users/BagToad","html_url":"https://github.com/BagToad","followers_url":"https://api.github.com/users/BagToad/followers","following_url":"https://api.github.com/users/BagToad/following{/other_user}","gists_url":"https://api.github.com/users/BagToad/gists{/gist_id}","starred_url":"https://api.github.com/users/BagToad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"I'm a bit confused, sorry. Can you clarify if you are asking a if the current implementation works or if your suggestion works? Can you also please clarify if you tested your proposed solution and what the benefits are with using it? Are you suggesting that the current implementation actually doesn't set this config properly?\r\n\r\nNote: I'm not off-hand familiar with git config syntax, but I'm assuming you have some knowledge that I don't and I'd very much appreciate you sharing more of your thoughts here 🙏","created_at":"2025-03-06T19:51:58Z","updated_at":"2025-03-06T19:51:58Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983966154","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983966154"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983966154"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983966154/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":38,"original_line":38,"side":"RIGHT","in_reply_to_id":1983502259,"author_association":"MEMBER","original_position":35,"position":38,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983966229","pull_request_review_id":2665475245,"id":1983966229,"node_id":"PRRC_kwDODKw3uc52QOwV","diff_hunk":"@@ -0,0 +1,33 @@\n+# Setup environment variables used for testscript\n+env REPO=${SCRIPT_NAME}-${RANDOM_STRING}\n+\n+# Use gh as a credential helper\n+exec gh auth setup-git\n+\n+# Create a repository with a file so it has a default branch\n+exec gh repo create ${ORG}/${REPO} --add-readme --private\n+\n+# Defer repo cleanup of repo\n+defer gh repo delete --yes ${ORG}/${REPO}\n+exec gh repo view ${ORG}/${REPO} --json id --jq '.id'\n+stdout2env REPO_ID\n+\n+# Clone the repo\n+exec gh repo clone ${ORG}/${REPO}\n+cd ${REPO}\n+\n+# Configure default push behavior so local and remote branches have to be the same\n+exec git config push.default simple","path":"acceptance/testdata/pr/pr-create-respects-simple-pushdefault.txtar","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.github.com/users/BagToad","html_url":"https://github.com/BagToad","followers_url":"https://api.github.com/users/BagToad/followers","following_url":"https://api.github.com/users/BagToad/following{/other_user}","gists_url":"https://api.github.com/users/BagToad/gists{/gist_id}","starred_url":"https://api.github.com/users/BagToad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"I'm a bit confused, sorry. Can you clarify if you are asking a if the current implementation works or if your suggestion works? Can you also please clarify if you tested your proposed solution and what the benefits are with using it? Are you suggesting that the current implementation actually doesn't set this config properly?\r\n\r\nNote: I'm not off-hand familiar with git config syntax, but I'm assuming you have some knowledge that I don't and I'd very much appreciate you sharing more of your thoughts here 🙏","created_at":"2025-03-06T19:52:02Z","updated_at":"2025-03-06T19:52:02Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983966229","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983966229"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983966229"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983966229/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":20,"original_line":20,"side":"RIGHT","in_reply_to_id":1983502716,"author_association":"MEMBER","original_position":20,"position":20,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983978080","pull_request_review_id":2665494693,"id":1983978080,"node_id":"PRRC_kwDODKw3uc52QRpg","diff_hunk":"@@ -336,9 +334,9 @@ func createRun(opts *CreateOptions) error {\n \n \tif opts.IO.CanPrompt() {\n \t\tfmt.Fprintf(opts.IO.ErrOut, message,\n-\t\t\tcs.Cyan(ctx.HeadBranchLabel),\n+\t\t\tcs.Cyan(ctx.PrRefs.GetPRHeadLabel()),","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.github.com/users/BagToad","html_url":"https://github.com/BagToad","followers_url":"https://api.github.com/users/BagToad/followers","following_url":"https://api.github.com/users/BagToad/following{/other_user}","gists_url":"https://api.github.com/users/BagToad/gists{/gist_id}","starred_url":"https://api.github.com/users/BagToad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"I'm going to say that cosmetic changes to the Finder methods are out of scope for this PR.\r\n\r\nAs for `prRefs`, this is consistent with the naming convention inside the finder, see the `Find` implementation, for example:\r\n\r\nhttps://github.com/cli/cli/blob/fc19ff321a4b7f4198f788f08da20249c7950fbd/pkg/cmd/pr/shared/finder.go#L183\r\n\r\nI'm strongly opposed to making a change to a naming convention in _only_ `create.go`. I also think any cosmetic changes that lean into the Finder's implementation are out of scope because it is not relevant to the Goal of this PR, which is to implement `@{push}` revision support for the head ref.\r\n\r\nFor the above reasons, I'm going to resolve this conversation. If anyone feels strongly, I think a follow-up Issue & PR might be more appropriate. ","created_at":"2025-03-06T20:02:02Z","updated_at":"2025-03-06T20:02:02Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983978080","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983978080"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983978080"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983978080/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":337,"side":"RIGHT","in_reply_to_id":1983517537,"author_association":"MEMBER","original_position":42,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983979230","pull_request_review_id":2665496516,"id":1983979230,"node_id":"PRRC_kwDODKw3uc52QR7e","diff_hunk":"@@ -76,14 +76,12 @@ type CreateContext struct {\n \t// This struct stores contextual data about the creation process and is for building up enough\n \t// data to create a pull request\n \tRepoContext        *ghContext.ResolvedRemotes\n-\tBaseRepo           *api.Repository\n-\tHeadRepo           ghrepo.Interface\n+\tPrRefs             shared.PullRequestRefs\n \tBaseTrackingBranch string\n-\tBaseBranch         string\n-\tHeadBranch         string\n-\tHeadBranchLabel    string\n+\tBaseBranch         string // Currently not supported by shared.PullRequestRefs struct\n \tHeadRemote         *ghContext.Remote\n-\tIsPushEnabled      bool\n+\tisPushEnabled      bool\n+\tforkHeadRepo       bool","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.github.com/users/BagToad","html_url":"https://github.com/BagToad","followers_url":"https://api.github.com/users/BagToad/followers","following_url":"https://api.github.com/users/BagToad/following{/other_user}","gists_url":"https://api.github.com/users/BagToad/gists{/gist_id}","starred_url":"https://api.github.com/users/BagToad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"I'd also like to hear a reason for increasing the surface area here.","created_at":"2025-03-06T20:02:59Z","updated_at":"2025-03-06T20:02:59Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983979230","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983979230"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983979230"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983979230/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":83,"start_side":"RIGHT","line":null,"original_line":84,"side":"RIGHT","in_reply_to_id":1983568420,"author_association":"MEMBER","original_position":15,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983985791","pull_request_review_id":2665506997,"id":1983985791,"node_id":"PRRC_kwDODKw3uc52QTh_","diff_hunk":"@@ -1761,11 +1721,14 @@ func Test_generateCompareURL(t *testing.T) {\n \t\t{\n \t\t\tname: \"'/'s in branch names/labels are percent-encoded\",\n \t\t\tctx: CreateContext{\n-\t\t\t\tBaseRepo:        api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER\"}}, \"github.com\"),\n-\t\t\t\tBaseBranch:      \"main/trunk\",\n-\t\t\t\tHeadBranchLabel: \"owner:feature\",\n+\t\t\t\tPrRefs: shared.PullRequestRefs{\n+\t\t\t\t\tBaseRepo:   api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER-UPSTREAM\"}}, \"github.com\"),\n+\t\t\t\t\tHeadRepo:   api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER\"}}, \"github.com\"),\n+\t\t\t\t\tBranchName: \"feature\",\n+\t\t\t\t},\n+\t\t\t\tBaseBranch: \"main/trunk\",\n \t\t\t},\n-\t\t\twant:    \"https://github.com/OWNER/REPO/compare/main%2Ftrunk...owner:feature?body=&expand=1\",\n+\t\t\twant:    \"https://github.com/OWNER-UPSTREAM/REPO/compare/main%2Ftrunk...OWNER:feature?body=&expand=1\",","path":"pkg/cmd/pr/create/create_test.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.github.com/users/BagToad","html_url":"https://github.com/BagToad","followers_url":"https://api.github.com/users/BagToad/followers","following_url":"https://api.github.com/users/BagToad/following{/other_user}","gists_url":"https://api.github.com/users/BagToad/gists{/gist_id}","starred_url":"https://api.github.com/users/BagToad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"> [OWNER-UPSTREAM](https://github.com/search?q=repo%3Acli%2Fcli%20%22OWNER-UPSTREAM%22&type=code) seems like new nomenclature\r\n\r\nI wish we had some style guide for these things if they're going to be details that warrant PR comments. \r\n\r\nI want consistency, but it's difficult to understand what that consistency should be.\r\n\r\n> As for bullet 2, @andyfeller, I'm not sure we currently support Organization forks, right? So all of these would be user forks. As for the monalisa owner, I think this is commonly used but it isn't established nomenclature and was a MAJOR cause of confusion for me while refactoring the Finder. That's why I settled on UPSTREAMOWNER and ORIGINOWNER.\r\n\r\nYeah, I prefer to be clear here. I also have this confusion. I want to know what is the upstream and what is the owner without thinking about it. I would be in favor of using `ORIGINOWNER` and `UPSTREAMOWNER` here.\r\n\r\n","created_at":"2025-03-06T20:08:31Z","updated_at":"2025-03-06T20:45:42Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983985791","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983985791"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983985791"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983985791/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":1724,"start_side":"RIGHT","line":null,"original_line":1731,"side":"RIGHT","in_reply_to_id":1983585639,"author_association":"MEMBER","original_position":382,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983989046","pull_request_review_id":2665512320,"id":1983989046,"node_id":"PRRC_kwDODKw3uc52QUU2","diff_hunk":"@@ -429,7 +427,7 @@ func createRun(opts *CreateOptions) error {\n \t\t}\n \n \t\tallowPreview := !state.HasMetadata() && shared.ValidURL(openURL) && !opts.DryRun\n-\t\tallowMetadata := ctx.BaseRepo.ViewerCanTriage()\n+\t\tallowMetadata := ctx.PrRefs.BaseRepo.(*api.Repository).ViewerCanTriage()","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.github.com/users/BagToad","html_url":"https://github.com/BagToad","followers_url":"https://api.github.com/users/BagToad/followers","following_url":"https://api.github.com/users/BagToad/following{/other_user}","gists_url":"https://api.github.com/users/BagToad/gists{/gist_id}","starred_url":"https://api.github.com/users/BagToad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"I think `ghRepo` does not have some methods like `ViewerCanTriage`. There's a compiler error without it.","created_at":"2025-03-06T20:11:26Z","updated_at":"2025-03-06T20:11:26Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983989046","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983989046"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983989046"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983989046/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":430,"side":"RIGHT","in_reply_to_id":1983739533,"author_association":"MEMBER","original_position":63,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983990487","pull_request_review_id":2665514699,"id":1983990487,"node_id":"PRRC_kwDODKw3uc52QUrX","diff_hunk":"@@ -486,7 +484,7 @@ var regexPattern = regexp.MustCompile(`(?m)^`)\n \n func initDefaultTitleBody(ctx CreateContext, state *shared.IssueMetadataState, useFirstCommit bool, addBody bool) error {\n \tbaseRef := ctx.BaseTrackingBranch\n-\theadRef := ctx.HeadBranch\n+\theadRef := ctx.PrRefs.BranchName","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.githu