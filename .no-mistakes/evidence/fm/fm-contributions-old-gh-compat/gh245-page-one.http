api.github.com/users/andyfeller/gists{/gist_id}","starred_url":"https://api.github.com/users/andyfeller/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andyfeller/subscriptions","organizations_url":"https://api.github.com/users/andyfeller/orgs","repos_url":"https://api.github.com/users/andyfeller/repos","events_url":"https://api.github.com/users/andyfeller/events{/privacy}","received_events_url":"https://api.github.com/users/andyfeller/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"```suggestion\r\n# Defer repo cleanup of fork\r\ndefer gh repo delete --yes ${USER}/${FORK}\r\n\r\n# Retrieve fork repository information\r\nsleep 5\r\nexec gh repo view ${USER}/${FORK} --json id --jq '.id'\r\nstdout2env FORK_ID\r\n```","created_at":"2025-03-06T14:52:20Z","updated_at":"2025-03-06T15:42:55Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983501878","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983501878"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983501878"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983501878/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":23,"original_start_line":23,"start_side":"RIGHT","line":null,"original_line":29,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":27,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983502259","pull_request_review_id":2664654277,"id":1983502259,"node_id":"PRRC_kwDODKw3uc52Odez","diff_hunk":"@@ -0,0 +1,46 @@\n+skip 'it creates a fork owned by the user running the test'\n+\n+# Setup environment variables used for testscript\n+env REPO=${SCRIPT_NAME}-${RANDOM_STRING}\n+env FORK=${REPO}-fork\n+\n+# Use gh as a credential helper\n+exec gh auth setup-git\n+\n+# Get the current username for the fork owner\n+exec gh api user --jq .login\n+stdout2env USER\n+\n+# Create a repository to act as upstream with a file so it has a default branch\n+exec gh repo create ${ORG}/${REPO} --add-readme --private\n+\n+# Defer repo cleanup of upstream\n+defer gh repo delete --yes ${ORG}/${REPO}\n+\n+# Create a user fork of repository. This will be owned by USER.\n+exec gh repo fork ${ORG}/${REPO} --fork-name ${FORK}\n+\n+# Defer repo cleanup of fork\n+defer gh repo delete --yes ${USER}/${FORK}\n+sleep 5\n+exec gh repo view ${USER}/${FORK} --json id --jq '.id'\n+stdout2env FORK_ID\n+\n+# Clone the repo\n+exec gh repo clone ${USER}/${FORK}\n+cd ${FORK}\n+\n+# Prepare a branch where changes are pulled from the upstream default branch but pushed to fork\n+exec git checkout -b feature-branch upstream/main\n+exec git config remote.pushDefault origin","path":"acceptance/testdata/pr/pr-create-respects-remote-pushdefault.txtar","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"andyfeller","id":2089743,"node_id":"MDQ6VXNlcjIwODk3NDM=","avatar_url":"https://avatars.githubusercontent.com/u/2089743?v=4","gravatar_id":"","url":"https://api.github.com/users/andyfeller","html_url":"https://github.com/andyfeller","followers_url":"https://api.github.com/users/andyfeller/followers","following_url":"https://api.github.com/users/andyfeller/following{/other_user}","gists_url":"https://api.github.com/users/andyfeller/gists{/gist_id}","starred_url":"https://api.github.com/users/andyfeller/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andyfeller/subscriptions","organizations_url":"https://api.github.com/users/andyfeller/orgs","repos_url":"https://api.github.com/users/andyfeller/repos","events_url":"https://api.github.com/users/andyfeller/events{/privacy}","received_events_url":"https://api.github.com/users/andyfeller/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"```suggestion\r\nexec git config set remote.pushDefault origin\r\n```","created_at":"2025-03-06T14:52:33Z","updated_at":"2025-03-06T15:42:55Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983502259","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983502259"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983502259"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983502259/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":38,"original_line":38,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":35,"position":38,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983502716","pull_request_review_id":2664654277,"id":1983502716,"node_id":"PRRC_kwDODKw3uc52Odl8","diff_hunk":"@@ -0,0 +1,33 @@\n+# Setup environment variables used for testscript\n+env REPO=${SCRIPT_NAME}-${RANDOM_STRING}\n+\n+# Use gh as a credential helper\n+exec gh auth setup-git\n+\n+# Create a repository with a file so it has a default branch\n+exec gh repo create ${ORG}/${REPO} --add-readme --private\n+\n+# Defer repo cleanup of repo\n+defer gh repo delete --yes ${ORG}/${REPO}\n+exec gh repo view ${ORG}/${REPO} --json id --jq '.id'\n+stdout2env REPO_ID\n+\n+# Clone the repo\n+exec gh repo clone ${ORG}/${REPO}\n+cd ${REPO}\n+\n+# Configure default push behavior so local and remote branches have to be the same\n+exec git config push.default simple","path":"acceptance/testdata/pr/pr-create-respects-simple-pushdefault.txtar","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"andyfeller","id":2089743,"node_id":"MDQ6VXNlcjIwODk3NDM=","avatar_url":"https://avatars.githubusercontent.com/u/2089743?v=4","gravatar_id":"","url":"https://api.github.com/users/andyfeller","html_url":"https://github.com/andyfeller","followers_url":"https://api.github.com/users/andyfeller/followers","following_url":"https://api.github.com/users/andyfeller/following{/other_user}","gists_url":"https://api.github.com/users/andyfeller/gists{/gist_id}","starred_url":"https://api.github.com/users/andyfeller/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andyfeller/subscriptions","organizations_url":"https://api.github.com/users/andyfeller/orgs","repos_url":"https://api.github.com/users/andyfeller/repos","events_url":"https://api.github.com/users/andyfeller/events{/privacy}","received_events_url":"https://api.github.com/users/andyfeller/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"```suggestion\r\nexec git config set push.default simple\r\n```","created_at":"2025-03-06T14:52:51Z","updated_at":"2025-03-06T15:42:55Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983502716","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983502716"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983502716"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983502716/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":20,"original_line":20,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":20,"position":20,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983517537","pull_request_review_id":2664654277,"id":1983517537,"node_id":"PRRC_kwDODKw3uc52OhNh","diff_hunk":"@@ -336,9 +334,9 @@ func createRun(opts *CreateOptions) error {\n \n \tif opts.IO.CanPrompt() {\n \t\tfmt.Fprintf(opts.IO.ErrOut, message,\n-\t\t\tcs.Cyan(ctx.HeadBranchLabel),\n+\t\t\tcs.Cyan(ctx.PrRefs.GetPRHeadLabel()),","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"andyfeller","id":2089743,"node_id":"MDQ6VXNlcjIwODk3NDM=","avatar_url":"https://avatars.githubusercontent.com/u/2089743?v=4","gravatar_id":"","url":"https://api.github.com/users/andyfeller","html_url":"https://github.com/andyfeller","followers_url":"https://api.github.com/users/andyfeller/followers","following_url":"https://api.github.com/users/andyfeller/following{/other_user}","gists_url":"https://api.github.com/users/andyfeller/gists{/gist_id}","starred_url":"https://api.github.com/users/andyfeller/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andyfeller/subscriptions","organizations_url":"https://api.github.com/users/andyfeller/orgs","repos_url":"https://api.github.com/users/andyfeller/repos","events_url":"https://api.github.com/users/andyfeller/events{/privacy}","received_events_url":"https://api.github.com/users/andyfeller/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"I'm not saying this has to change here but there are 2 subjective concerns I have with this on a meta level:\r\n\r\n1. Inconsistent acronym usage; `PrRefs` versus `GetPRHeadLabel`\r\n2. Use of acronym versus primitive name; `Pr`/`PR` versus `PullRequest`\r\n\r\nAnother example being `PrRefs: shared.PullRequestRefs{` later in the PR.\r\n\r\nPersonally, I value using primitive's full or abbreviated name in our logic and avoiding acronyms for them.  For example, Repository and Repo are well known across GitHub so those are okay.\r\n\r\nAll of that said, I can only realistically expect the former concern is considered while the latter is just sharing personal value.","created_at":"2025-03-06T15:00:54Z","updated_at":"2025-03-06T15:42:55Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983517537","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983517537"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983517537"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983517537/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":337,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":42,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983538219","pull_request_review_id":2664654277,"id":1983538219,"node_id":"PRRC_kwDODKw3uc52OmQr","diff_hunk":"@@ -638,19 +560,26 @@ func NewCreateContext(opts *CreateOptions) (*CreateContext, error) {\n \tif err != nil {\n \t\treturn nil, err\n \t}\n+\n+\tgitClient := opts.GitClient\n+\tif ucc, err := gitClient.UncommittedChangeCount(context.Background()); err == nil && ucc > 0 {\n+\t\tfmt.Fprintf(opts.IO.ErrOut, \"Warning: %s\\n\", text.Pluralize(ucc, \"uncommitted change\"))\n+\t}","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"andyfeller","id":2089743,"node_id":"MDQ6VXNlcjIwODk3NDM=","avatar_url":"https://avatars.githubusercontent.com/u/2089743?v=4","gravatar_id":"","url":"https://api.github.com/users/andyfeller","html_url":"https://github.com/andyfeller","followers_url":"https://api.github.com/users/andyfeller/followers","following_url":"https://api.github.com/users/andyfeller/following{/other_user}","gists_url":"https://api.github.com/users/andyfeller/gists{/gist_id}","starred_url":"https://api.github.com/users/andyfeller/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andyfeller/subscriptions","organizations_url":"https://api.github.com/users/andyfeller/orgs","repos_url":"https://api.github.com/users/andyfeller/repos","events_url":"https://api.github.com/users/andyfeller/events{/privacy}","received_events_url":"https://api.github.com/users/andyfeller/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"**thought:** I see this is existing behavior that was moved from deeper in the `gh pr create` process, so I'm not expecting anything change here.\r\n\r\nThat said, it raised some questions for future consideration:\r\n\r\n- Should this warning nudge the user to cancel the command so they can commit the changes?\r\n- Should this warning be more explicit that uncommitted changes won't be included in the PR created?  Or will `gh pr create` try to commit them for the user before creating the PR?\r\n\r\nEither way, I appreciate communicating to the user; just seeing what actionable advice we should give them.","created_at":"2025-03-06T15:11:50Z","updated_at":"2025-03-10T19:10:29Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983538219","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983538219"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983538219"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983538219/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":565,"start_side":"RIGHT","line":null,"original_line":567,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":197,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983568420","pull_request_review_id":2664654277,"id":1983568420,"node_id":"PRRC_kwDODKw3uc52Otok","diff_hunk":"@@ -76,14 +76,12 @@ type CreateContext struct {\n \t// This struct stores contextual data about the creation process and is for building up enough\n \t// data to create a pull request\n \tRepoContext        *ghContext.ResolvedRemotes\n-\tBaseRepo           *api.Repository\n-\tHeadRepo           ghrepo.Interface\n+\tPrRefs             shared.PullRequestRefs\n \tBaseTrackingBranch string\n-\tBaseBranch         string\n-\tHeadBranch         string\n-\tHeadBranchLabel    string\n+\tBaseBranch         string // Currently not supported by shared.PullRequestRefs struct\n \tHeadRemote         *ghContext.Remote\n-\tIsPushEnabled      bool\n+\tisPushEnabled      bool\n+\tforkHeadRepo       bool","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"andyfeller","id":2089743,"node_id":"MDQ6VXNlcjIwODk3NDM=","avatar_url":"https://avatars.githubusercontent.com/u/2089743?v=4","gravatar_id":"","url":"https://api.github.com/users/andyfeller","html_url":"https://github.com/andyfeller","followers_url":"https://api.github.com/users/andyfeller/followers","following_url":"https://api.github.com/users/andyfeller/following{/other_user}","gists_url":"https://api.github.com/users/andyfeller/gists{/gist_id}","starred_url":"https://api.github.com/users/andyfeller/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andyfeller/subscriptions","organizations_url":"https://api.github.com/users/andyfeller/orgs","repos_url":"https://api.github.com/users/andyfeller/repos","events_url":"https://api.github.com/users/andyfeller/events{/privacy}","received_events_url":"https://api.github.com/users/andyfeller/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"Is there a need to not export these fields?","created_at":"2025-03-06T15:28:11Z","updated_at":"2025-03-06T15:42:55Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983568420","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983568420"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983568420"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983568420/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":83,"start_side":"RIGHT","line":null,"original_line":84,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":15,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983585639","pull_request_review_id":2664654277,"id":1983585639,"node_id":"PRRC_kwDODKw3uc52Ox1n","diff_hunk":"@@ -1761,11 +1721,14 @@ func Test_generateCompareURL(t *testing.T) {\n \t\t{\n \t\t\tname: \"'/'s in branch names/labels are percent-encoded\",\n \t\t\tctx: CreateContext{\n-\t\t\t\tBaseRepo:        api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER\"}}, \"github.com\"),\n-\t\t\t\tBaseBranch:      \"main/trunk\",\n-\t\t\t\tHeadBranchLabel: \"owner:feature\",\n+\t\t\t\tPrRefs: shared.PullRequestRefs{\n+\t\t\t\t\tBaseRepo:   api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER-UPSTREAM\"}}, \"github.com\"),\n+\t\t\t\t\tHeadRepo:   api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER\"}}, \"github.com\"),\n+\t\t\t\t\tBranchName: \"feature\",\n+\t\t\t\t},\n+\t\t\t\tBaseBranch: \"main/trunk\",\n \t\t\t},\n-\t\t\twant:    \"https://github.com/OWNER/REPO/compare/main%2Ftrunk...owner:feature?body=&expand=1\",\n+\t\t\twant:    \"https://github.com/OWNER-UPSTREAM/REPO/compare/main%2Ftrunk...OWNER:feature?body=&expand=1\",","path":"pkg/cmd/pr/create/create_test.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"andyfeller","id":2089743,"node_id":"MDQ6VXNlcjIwODk3NDM=","avatar_url":"https://avatars.githubusercontent.com/u/2089743?v=4","gravatar_id":"","url":"https://api.github.com/users/andyfeller","html_url":"https://github.com/andyfeller","followers_url":"https://api.github.com/users/andyfeller/followers","following_url":"https://api.github.com/users/andyfeller/following{/other_user}","gists_url":"https://api.github.com/users/andyfeller/gists{/gist_id}","starred_url":"https://api.github.com/users/andyfeller/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andyfeller/subscriptions","organizations_url":"https://api.github.com/users/andyfeller/orgs","repos_url":"https://api.github.com/users/andyfeller/repos","events_url":"https://api.github.com/users/andyfeller/events{/privacy}","received_events_url":"https://api.github.com/users/andyfeller/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"Is there some other nomenclature we use in other tests other than `OWNER-UPSTREAM` / `OWNER`?\r\n\r\nI ask for 2 reasons:\r\n\r\n1. [`OWNER-UPSTREAM`](https://github.com/search?q=repo%3Acli%2Fcli%20%22OWNER-UPSTREAM%22&type=code) seems like new nomenclature\r\n2. There are 2 types of forking scenarios and wonder if its valuable making this a little more explicit:\r\n   1. User fork\r\n   2. Organization fork\r\n\r\nI assume all of these are user forks, which [other `gh` tests have used `monalisa` as a concrete owner](https://github.com/search?q=repo%3Acli%2Fcli+path%3A**%2F*_test.go+mona&type=code)\r\n\r\nhttps://github.com/cli/cli/blob/fc19ff321a4b7f4198f788f08da20249c7950fbd/internal/ghrepo/repo_test.go#L18-L24","created_at":"2025-03-06T15:36:29Z","updated_at":"2025-03-06T15:42:55Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983585639","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983585639"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983585639"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983585639/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":1724,"start_side":"RIGHT","line":null,"original_line":1731,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":382,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983724071","pull_request_review_id":2665071223,"id":1983724071,"node_id":"PRRC_kwDODKw3uc52PTon","diff_hunk":"@@ -310,7 +308,7 @@ func createRun(opts *CreateOptions) error {\n \t}\n \n \texistingPR, _, err := opts.Finder.Find(shared.FindOptions{\n-\t\tSelector:   ctx.HeadBranchLabel,\n+\t\tSelector:   ctx.PrRefs.GetPRHeadLabel(),","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"jtmcg","id":5891697,"node_id":"MDQ6VXNlcjU4OTE2OTc=","avatar_url":"https://avatars.githubusercontent.com/u/5891697?v=4","gravatar_id":"","url":"https://api.github.com/users/jtmcg","html_url":"https://github.com/jtmcg","followers_url":"https://api.github.com/users/jtmcg/followers","following_url":"https://api.github.com/users/jtmcg/following{/other_user}","gists_url":"https://api.github.com/users/jtmcg/gists{/gist_id}","starred_url":"https://ap