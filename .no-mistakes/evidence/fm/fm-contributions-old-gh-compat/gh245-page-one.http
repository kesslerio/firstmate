ner: api.RepositoryOwner{Login: \"OWNER\"}}, \"github.com\"),\n-\t\t\t\tBaseBranch:      \"main/trunk\",\n-\t\t\t\tHeadBranchLabel: \"owner:!$&'()+,;=@\",\n+\t\t\t\tPrRefs: shared.PullRequestRefs{\n+\t\t\t\t\tBaseRepo:   api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER-UPSTREAM\"}}, \"github.com\"),\n+\t\t\t\t\tHeadRepo:   api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER\"}}, \"github.com\"),\n+\t\t\t\t\tBranchName: \"!$&'()+,;=@\",\n+\t\t\t\t},\n+\t\t\t\tBaseBranch: \"main/trunk\",\n+\t\t\t\t//TODO check this\n+\t\t\t\t// HeadBranchLabel: \"owner:!$&'()+,;=@\",","path":"pkg/cmd/pr/create/create_test.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"BagToad","id":47394200,"node_id":"MDQ6VXNlcjQ3Mzk0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/47394200?v=4","gravatar_id":"","url":"https://api.github.com/users/BagToad","html_url":"https://github.com/BagToad","followers_url":"https://api.github.com/users/BagToad/followers","following_url":"https://api.github.com/users/BagToad/following{/other_user}","gists_url":"https://api.github.com/users/BagToad/gists{/gist_id}","starred_url":"https://api.github.com/users/BagToad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"This is a mistake! Thanks for catching that. I'm going to delete these comments.\r\n\r\n```suggestion\r\n```","created_at":"2025-03-06T20:39:46Z","updated_at":"2025-03-06T20:39:47Z","html_url":"https://github.com/cli/cli/pull/10513#discussio