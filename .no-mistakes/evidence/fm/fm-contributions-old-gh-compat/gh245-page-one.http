cg/subscriptions","organizations_url":"https://api.github.com/users/jtmcg/orgs","repos_url":"https://api.github.com/users/jtmcg/repos","events_url":"https://api.github.com/users/jtmcg/events{/privacy}","received_events_url":"https://api.github.com/users/jtmcg/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"I think you're describing the logic that follows this. My question was more about what happens to the error. That definitely wasn't clear!\r\n\r\nLooks like it gets swallowed (I was wondering if you knew of handling of it further down). As such, I would suggest this change (including the above line)\r\n\r\n```suggestion\r\n                headRemote, _ := remotes.FindByRepo(prRefs.HeadRepo.RepoOwner(), prRefs.HeadRepo.RepoName())\r\n\t\tif headRemote != nil {\r\n```\r\n\r\nThat way we are clearly communicating that we don't care about this error and reall just care about the `headRemote`","created_at":"2025-03-06T21:16:33Z","updated_at":"2025-03-06T21:16:33Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1984062018","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1984062018"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1984062018"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1984062018/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":655,"side":"RIGHT","in_reply_to_id":1983787141,"author_association":"CONTRIBUTOR","original_position":314,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1984079509","pull_request_review_id":2665681082,"id":1984079509,"node_id":"PRRC_kwDODKw3uc52QqaV","diff_hunk":"@@ -731,61 +706,57 @@ func NewCreateContext(opts *CreateOptions) (*CreateContext, error) {\n \t\t}\n \n \t\tif !hasOwnFork {\n-\t\t\tpushOptions = append(pushOptions, \"Create a fork of \"+ghrepo.FullName(baseRepo))\n+\t\t\tpushOptions = append(pushOptions, \"Create a fork of \"+ghrepo.FullName(prRefs.BaseRepo))\n \t\t}\n \t\tpushOptions = append(pushOptions, \"Skip pushing the branch\")\n \t\tpushOptions = append(pushOptions, \"Cancel\")\n \n-\t\tselectedOption, err := opts.Prompter.Select(fmt.Sprintf(\"Where should we push the '%s' branch?\", headBranch), \"\", pushOptions)\n+\t\tselectedOption, err := opts.Prompter.Select(fmt.Sprintf(\"Where should we push the '%s' branch?\", prRefs.BranchName), \"\", pushOptions)\n \t\tif err != nil {\n \t\t\treturn nil, err\n \t\t}\n \n \t\tif selectedOption < len(pushableRepos) {\n-\t\t\theadRepo = pushableRepos[selectedOption]\n-\t\t\tif !ghrepo.IsSame(baseRepo, headRepo) {\n-\t\t\t\theadBranchLabel = fmt.Sprintf(\"%s:%s\", headRepo.RepoOwner(), headBranch)\n-\t\t\t}\n+\t\t\tprRefs.HeadRepo = pushableRepos[selectedOption]\n \t\t} else if pushOptions[selectedOption] == \"Skip pushing the branch\" {\n \t\t\tisPushEnabled = false\n \t\t} else if pushOptions[selectedOption] == \"Cancel\" {\n \t\t\treturn nil, cmdutil.CancelError\n \t\t} else {\n \t\t\t// \"Create a fork of ...\"\n-\t\t\theadBranchLabel = fmt.Sprintf(\"%s:%s\", currentLogin, headBranch)\n+\t\t\tforkHeadRepo = true\n+\t\t\tprRefs.HeadRepo = ghrepo.New(currentLogin, prRefs.HeadRepo.RepoName())\n \t\t}\n \t}\n \n-\tif headRepo == nil && isPushEnabled && !opts.IO.CanPrompt() {\n+\tif prRefs.HeadRepo == nil && isPushEnabled && !opts.IO.CanPrompt() {\n \t\tfmt.Fprintf(opts.IO.ErrOut, \"aborted: you must first push the current branch to a remote, or use the --head flag\")\n \t\treturn nil, cmdutil.SilentError\n \t}\n \n \tbaseBranch := opts.BaseBranch\n \tif baseBranch == \"\" {\n-\t\tbaseBranch = headBranchConfig.MergeBase\n+\t\tbaseBranch = targetHeadBranchConfig.MergeBase\n \t}\n \tif baseBranch == \"\" {\n-\t\tbaseBranch = baseRepo.DefaultBranchRef.Name\n+\t\tbaseBranch = targetBaseRepo.DefaultBranchRef.Name\n \t}\n-\tif headBranch == baseBranch && headRepo != nil && ghrepo.IsSame(baseRepo, headRepo) {\n+\tif prRefs.BranchName == baseBranch && prRefs.HeadRepo != nil && ghrepo.IsSame(prRefs.BaseRepo, prRefs.HeadRepo) {","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"jtmcg","id":5891697,"node_id":"MDQ6VXNlcjU4OTE2OTc=","avatar_url":"https://avatars.githubusercontent.com/u/5891697?v=4","gravatar_id":"","url":"https://api.github.com/users/jtmcg","html_url":"https://github.com/jtmcg","followers_url":"https://api.github.com/users/jtmcg/followers","following_url":"https://api.github.com/users/jtmcg/following{/other_user}","gists_url":"https://api.github.com/users/jtmcg/gists{/gist_id}","starred_url":"https://api.github.com/users/jtmcg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jtmcg/subscriptions","organizations_url":"https://api.github.com/users/jtmcg/orgs","repos_url":"https://api.github.com/users/jtmcg/repos","events_url":"https://api.github.com/users/jtmcg/events{/privacy}","received_events_url":"https://api.github.com/users/jtmcg/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"I'm not sure, so bear with me as we work through this...\r\n\r\nThis is essentially checking that the `headRef` and `baseRef` aren't the same, right? It's getting the branch names from `targetHeadBranchConfig.MergeBase` or, if that doesn't work, `targetBaseRepo.DefaultBranchRef.Name`. The repos are coming from `prRefs`.\r\n\r\nThis, I think, is the third piece of evidence that we should add `BaseBranchName` to PRRefs. We already have `targetHeadBranchConfig` and `targetBaseRepo` passed into `ParsePRRefs`, so we could do this check in there. Then, we add something like\r\n\r\n```golang\r\nfunc (p *PullRequestRefs) IsTargetingSelf() bool {\r\n    return p.BaseBranchName == p.HeadBranchName && ghrepo.IsSame(p.BaseRepo, p.HeadRepo)\r\n}\r\n```\r\n\r\nThis moves all the config and repo parsing logic into `ParsePRRefs`, which is part of the point of it, and then gives us a really clear helper function to add here.\r\n\r\nOverall, I think that means the action here is to create a follow-up issue to add `BaseBranchName` to `PullRequestRefs` and capture all the places we've identified it would be useful.","created_at":"2025-03-06T21:29:48Z","updated_at":"2025-03-06T21:29:49Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1984079509","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1984079509"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1984079509"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1984079509/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"start_line":null,"original_start_line":739,"start_side":"RIGHT","line":null,"original_line":744,"side":"RIGHT","in_reply_to_id":1983804713,"author_association":"CONTRIBUTOR","original_position":411,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1984080826","pull_request_review_id":2665683348,"id":1984080826,"node_id":"PRRC_kwDODKw3uc52Qqu6","diff_hunk":"@@ -731,61 +706,57 @@ func NewCreateContext(opts *CreateOptions) (*CreateContext, error) {\n \t\t}\n \n \t\tif !hasOwnFork {\n-\t\t\tpushOptions = append(pushOptions, \"Create a fork of \"+ghrepo.FullName(baseRepo))\n+\t\t\tpushOptions = append(pushOptions, \"Create a fork of \"+ghrepo.FullName(prRefs.BaseRepo))\n \t\t}\n \t\tpushOptions = append(pushOptions, \"Skip pushing the branch\")\n \t\tpushOptions = append(pushOptions, \"Cancel\")\n \n-\t\tselectedOption, err := opts.Prompter.Select(fmt.Sprintf(\"Where should we push the '%s' branch?\", headBranch), \"\", pushOptions)\n+\t\tselectedOption, err := opts.Prompter.Select(fmt.Sprintf(\"Where should we push the '%s' branch?\", prRefs.BranchName), \"\", pushOptions)\n \t\tif err != nil {\n \t\t\treturn nil, err\n \t\t}\n \n \t\tif selectedOption < len(pushableRepos) {\n-\t\t\theadRepo = pushableRepos[selectedOption]\n-\t\t\tif !ghrepo.IsSame(baseRepo, headRepo) {\n-\t\t\t\theadBranchLabel = fmt.Sprintf(\"%s:%s\", headRepo.RepoOwner(), headBranch)\n-\t\t\t}\n+\t\t\tprRefs.HeadRepo = pushableRepos[selectedOption]\n \t\t} else if pushOptions[selectedOption] == \"Skip pushing the branch\" {\n \t\t\tisPushEnabled = false\n \t\t} else if pushOptions[selectedOption] == \"Cancel\" {\n \t\t\treturn nil, cmdutil.CancelError\n \t\t} else {\n \t\t\t// \"Create a fork of ...\"\n-\t\t\theadBranchLabel = fmt.Sprintf(\"%s:%s\", currentLogin, headBranch)\n+\t\t\tforkHeadRepo = true\n+\t\t\tprRefs.HeadRepo = ghrepo.New(currentLogin, prRefs.HeadRepo.RepoName())\n \t\t}\n \t}\n \n-\tif headRepo == nil && isPushEnabled && !opts.IO.CanPrompt() {\n+\tif prRefs.HeadRepo == nil && isPushEnabled && !opts.IO.CanPrompt() {\n \t\tfmt.Fprintf(opts.IO.ErrOut, \"aborted: you must first push the current branch to a remote, or use the --head flag\")\n \t\treturn nil, cmdutil.SilentError\n \t}\n \n \tbaseBranch := opts.BaseBranch\n \tif baseBranch == \"\" {\n-\t\tbaseBranch = headBranchConfig.MergeBase\n+\t\tbaseBranch = targetHeadBranchConfig.MergeBase\n \t}\n \tif baseBranch == \"\" {\n-\t\tbaseBranch = baseRepo.DefaultBranchRef.Name\n+\t\tbaseBranch = targetBaseRepo.DefaultBranchRef.Name\n \t}\n-\tif headBranch == baseBranch && headRepo != nil && ghrepo.IsSame(baseRepo, headRepo) {\n+\tif prRefs.BranchName == baseBranch && prRefs.HeadRepo != nil && ghrepo.IsSame(prRefs.BaseRepo, prRefs.HeadRepo) {\n \t\treturn nil, fmt.Errorf(\"must be on a branch named differently than %q\", baseBranch)\n \t}\n \n \tbaseTrackingBranch := baseBranch\n-\tif baseRemote, err := remotes.FindByRepo(baseRepo.RepoOwner(), baseRepo.RepoName()); err == nil {\n+\tif baseRemote, err := remotes.FindByRepo(prRefs.BaseRepo.RepoOwner(), prRefs.BaseRepo.RepoName()); err == nil {\n \t\tbaseTrackingBranch = fmt.Sprintf(\"%s/%s\", baseRemote.Name, baseBranch)\n \t}\n \n \treturn &CreateContext{\n-\t\tBaseRepo:           baseRepo,\n-\t\tHeadRepo:           headRepo,\n-\t\tBaseBranch:         baseBranch,\n+\t\tPrRefs:             prRefs,\n+\t\tBaseBranch:         baseBranch, // Currently not supported by shared.PullRequestRefs struct","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"jtmcg","id":5891697,"node_id":"MDQ6VXNlcjU4OTE2OTc=","avatar_url":"https://avatars.githubusercontent.com/u/5891697?v=4","gravatar_id":"","url":"https://api.github.com/users/jtmcg","html_url":"https://github.com/jtmcg","followers_url":"https://api.github.com/users/jtmcg/followers","following_url":"https://api.github.com/users/jtmcg/following{/other_user}","gists_url":"https://api.github.com/users/jtmcg/gists{/gist_id}","starred_url":"https://api.github.com/users/jtmcg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jtmcg/subscriptions","organizations_url":"https://api.github.com/users/jtmcg/orgs","repos_url":"https://api.github.com/users/jtmcg/repos","events_url":"https://api.github.com/users/jtmcg/events{/privacy}","received_events_url":"https://api.github.com/users/jtmcg/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"Haha oh I know. That comment was meant to be humorous, not accusatory 😬 Sorry if it came across differently","created_at":"2025-03-06T21:31:08Z","updated_at":"2025-03-06T21:31:08Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1984080826","pull_request_