s_url":"https://api.github.com/users/BagToad/subscriptions","organizations_url":"https://api.github.com/users/BagToad/orgs","repos_url":"https://api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"Confirming this has no test coverage:\r\n\r\n![image](https://github.com/user-attachments/assets/afd78d1d-0ed3-4f89-9197-d6c692dbfe79)\r\n","created_at":"2025-03-06T20:43:08Z","updated_at":"2025-03-06T20:43:09Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1984023670","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1984023670"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1984023670"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1984023670/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":565,"start_side":"RIGHT","line":null,"original_line":567,"side":"RIGHT","in_reply_to_id":1983538219,"author_association":"MEMBER","original_position":197,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1984031345","pull_request_review_id":2665596060,"id":1984031345,"node_id":"PRRC_kwDODKw3uc52Qepx","diff_hunk":"@@ -1761,11 +1721,14 @@ func Test_generateCompareURL(t *testing.T) {\n \t\t{\n \t\t\tname: \"'/'s in branch names/labels are percent-encoded\",\n \t\t\tctx: CreateContext{\n-\t\t\t\tBaseRepo:        api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER\"}}, \"github.com\"),\n-\t\t\t\tBaseBranch:      \"main/trunk\",\n-\t\t\t\tHeadBranchLabel: \"owner:feature\",\n+\t\t\t\tPrRefs: shared.PullRequestRefs{\n+\t\t\t\t\tBaseRepo:   api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER-UPSTREAM\"}}, \"github.com\"),\n+\t\t\t\t\tHeadRepo:   api.InitRepoHostname(&api.Repository{Name: \"REPO\", Owner: api.RepositoryOwner{Login: \"OWNER\"}}, \"github.com\"),\n+\t\t\t\t\tBranchName: \"feature\",\n+\t\t\t\t},\n+\t\t\t\tBaseBranch: \"main/trunk\",\n \t\t\t},\n-\t\t\twant:    \"https://github.com/OWNER/REPO/compare/main%2Ftrunk...owner:feature?body=&expand=1\",\n+\t\t\twant:    \"https://github.com/OWNER-UPSTREAM/REPO/compare/main%2Ftrunk...OWNER:feature?body=&expand=1\",","path":"pkg/cmd/pr/create/create_test.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"jtmcg","id":5891697,"node_id":"MDQ6VXNlcjU4OTE2OTc=","avatar_url":"https://avatars.githubusercontent.com/u/5891697?v=4","gravatar_id":"","url":"https://api.github.com/users/jtmcg","html_url":"https://github.com/jtmcg","followers_url":"https://api.github.com/users/jtmcg/followers","following_url":"https://api.github.com/users/jtmcg/following{/other_user}","gists_url":"https://api.github.com/users/jtmcg/gists{/gist_id}","starred_url":"https://api.github.com/users/jtmcg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jtmcg/subscriptions","organizations_url":"https://api.github.com/users/jtmcg/orgs","repos_url":"https://api.github.com/users/jtmcg/repos","events_url":"https://api.github.com/users/jtmcg/events{/privacy}","received_events_url":"https://api.github.com/users/jtmcg/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"Sounds like we just established the nomenclature for these tests: `ORIGINOWNER` and `UPSTREAMOWNER`.\r\n\r\nI feel you on wanting consistency, as it can be hard to reason about stuff when it doesn't exist... I think a more realistic goal is _clarity_ instead of consistency, as that's the whole point of nomenclature. We shouldn't enforce nomenclature for any other reason, and if it passes the _clarity_ check then I feel fine about it. This, as is, definitely helps with clarity 👍 \r\n\r\nOverall, I don't have a strong opinion on the naming, here, though I do suppose the consistency of using `ORIGINOWNER` and `UPSTREAMOWNER` would be beneficial to clarity. I suspect that if folks are trying to suss out what's going on in the future, they'll likely end up in both the PRRefs tests and these tests, so the consistency could reduce cognitive load. As such, I'd support using `ORIGINOWNER` and `UPSTREAMOWNER`","created_at":"2025-03-06T20:50:17Z","updated_at":"2025-03-06T21:02:13Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1984031345","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1984031345"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1984031345"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1984031345/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":1724,"start_side":"RIGHT","line":null,"original_line":1731,"side":"RIGHT","in_reply_to_id":1983585639,"author_association":"CONTRIBUTOR","original_position":382,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1984035530","pull_request_review_id":2665603340,"id":1984035530,"node_id":"PRRC_kwDODKw3uc52QfrK","diff_hunk":"@@ -429,7 +427,7 @@ func createRun(opts *CreateOptions) error {\n \t\t}\n \n \t\tallowPreview := !state.HasMetadata() && shared.ValidURL(openURL) && !opts.DryRun\n-\t\tallowMetadata := ctx.BaseRepo.ViewerCanTriage()\n+\t\tallowMetadata := ctx.PrRefs.BaseRepo.(*api.Repository).ViewerCanTriage()","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"jtmcg","id":5891697,"node_id":"MDQ6VXNlcjU4OTE2OTc=","avatar_url":"https://avatars.githubusercontent.com/u/5891697?v=4","gravatar_id":"","url":"https://api.github.com/users/jtmcg","html_url":"https://github.com/jtmcg","followers_url":"https://api.github.com/users/jtmcg/followers","following_url":"https://api.github.com/users/jtmcg/following{/other_user}","gists_url":"https://api.github.com/users/jtmcg/gists{/gist_id}","starred_url":"https://api.github.com/users/jtmcg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jtmcg/subscriptions","organizations_url":"https://api.github.com/users/jtmcg/orgs","repos_url":"https://api.github.com/users/jtmcg/repos","events_url":"https://api.github.com/users/jtmcg/events{/privacy}","received_events_url":"https://api.github.com/users/jtmcg/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"Hmm... I wonder if this is a by-product of the way that the [repo interface is written](https://github.com/cli/cli/blob/trunk/internal/ghrepo/repo.go). In particular, this line is super weird to me: https://github.com/cli/cli/blob/fc19ff321a4b7f4198f788f08da20249c7950fbd/internal/ghrepo/repo.go#L14-L18.\r\n\r\nIt's a bit on the nose naming the interface `Interface`. Like, did we really need this interface or was this an invented abstraction (as opposed to a discovered one)? Why is there a different repo for `gh` and `api`?\r\n\r\nThese are just musings and there's nothing actionable, here, but the type assertion is a bit of a smell (that you didn't introduce) for me.","created_at":"2025-03-06T20:54:16Z","updated_at":"2025-03-06T20:54:50Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1984035530","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1984035530"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1984035530"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1984035530/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":430,"side":"RIGHT","in_reply_to_id":1983739533,"author_association":"CONTRIBUTOR","original_position":63,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1984039532","pull_request_review_id":2665609951,"id":1984039532,"node_id":"PRRC_kwDODKw3uc52Qgps","diff_hunk":"@@ -638,19 +560,26 @@ func NewCreateContext(opts *CreateOptions) (*CreateContext, error) {\n \tif err != nil {\n \t\treturn nil, err\n \t}\n+\n+\tgitClient := opts.GitClient\n+\tif ucc, err := gitClient.UncommittedChangeCount(context.Background()); err == nil && ucc > 0 {\n+\t\tfmt.Fprintf(opts.IO.ErrOut, \"Warning: %s\\n\", text.Pluralize(ucc, \"uncommitted change\"))\n+\t}\n+\n+\t// Resolve base repo\n \trepoContext, err := ghContext.ResolveRemotesToRepos(remotes, client, opts.RepoOverride)\n \tif err != nil {\n \t\treturn nil, err\n \t}\n \n-\tvar baseRepo *api.Repository\n+\tvar targetBaseRepo *api.Repository","path":"pkg/cmd/pr/create/create.go","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"jtmcg","id":5891697,"node_id":"MDQ6VXNlcjU4OTE2OTc=","avatar_url":"https://avatars.githubusercontent.com/u/5891697?v=4","gravatar_id":"","url":"https://api.github.com/users/jtmcg","html_url":"https://github.com/jtmcg","followers_url":"https://api.github.com/users/jtmcg/followers","following_url":"https://api.github.com/users/jtmcg/following{/other_user}","gists_url":"https://api.github.com/users/jtmcg/gists{/gist_id}","starred_url":"https://api.github.com/users/jtmcg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jtmcg/subscriptions","organizations_url":"https://api.github.com/users/jtmcg/orgs","repos_url":"https://api.github.com/users/jtmcg/repos","events_url":"https://api.github.com/users/jtmcg/events{/privacy}","received_events_url":"https://api.github.com/users/jtmcg/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"Yeah, that clarifies what I suspected. I really like the name change for what it does - disambiguate when we have data we're not sure about from data we are sure about. \r\n\r\nI'm not sure I have a better idea about the name. `targetBaseRepo` seems decent. Maybe `computedBaseRepo`? Maybe we should ask ChatGPT 😆 I'll leave it to you, and this is non-blocking","created_at":"2025-03-06T20:57:52Z","updated_at":"2025-03-06T20:58:33Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1984039532","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1984039532"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1984039532"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1984039532/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":575,"side":"RIGHT","in_reply_to_id":1983746943,"author_association":"CONTRIBUTOR","original_position":206,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1984056767","pull_request_review_id":2665638186,"id":1984056767,"node_id":"PRRC_kwDODKw3uc52Qk2_","diff_hunk":"@@ -659,64 +588,110 @@ func NewCreateContext(opts *CreateOptions) (*CreateContext, error) {\n \t\treturn nil, err\n \t}\n \n-\tisPushEnabled := false\n-\theadBranch := opts.HeadBranch\n-\theadBranchLabel := opts.HeadBranch\n-\tif headBranch == \"\" {\n-\t\theadBranch, err = opts.Branch()\n+\t// Resolve target head branch name from either\n+\t// --head or the current branch.\n+\tvar targetHeadBranch string\n+\tvar targetHeadRepoOwner string\n+\n+\tpromptForHeadRepo := true\n+\n+\tif opts.HeadBranch != \"\" {\n+\t\tpromptForHeadRepo = false\n+\t\ttargetHeadBranch = opts.HeadBranch\n+\t\t// If the --head provided contains a colon, that means\n+\t\t// this is <repo_name>:<branch> syntax.\n+\t\tif idx := strings.IndexRune(opts.HeadBranch, ':'); idx >= 0 {\n+\t\t\ttargetHeadRepoOwner = opts.HeadBranch[:idx]\n+\t\t\ttargetHeadBranch = opts.HeadBranch[idx+1:]\n+\t\t}\n+\t} else {\n+\t\t// Use the current branch as the target local head branch when\n+\t\t// --head is not provided.\n+\t\ttargetHeadBranch, err = opts.Branch()\n \t\tif err != nil {\n \t\t\treturn nil, fmt.Errorf(\"could not determine the current branch: %w\", err)\n \t\t}\n-\t\theadBranchLabel = headBranch\n-\t\tisPushEnabled = true\n-\t} else if idx := strings.IndexRune(headBranch, ':'); idx >= 0 {\n-\t\theadBranch = headBranch[idx+1:]\n \t}\n \n-\tgitClient := opts.GitClient\n-\tif ucc, err := gitClient.UncommittedChangeCount(context.Background()); err == nil && ucc > 0 {\n-\t\tfmt.Fprintf(opts.IO.ErrOut, \"Warning: %s\\n\", text.Pluralize(ucc, \"uncommitted change\"))\n+\ttargetHeadBranchConfig, err := gitClient.ReadBranchConfig(context.Background(), targetHeadBranch)\n+\tif err != nil {\n+\t\treturn nil, err\n \t}\n \n-\tvar headRepo ghrepo.Interface\n-\tvar headRemote *ghContext.Remote\n+\t// See if we can determine if this branch has been push previously with\n+\t// Git configurations and @{push} revision syntax.\n+\tremotePushDefault, err := opts.GitClient.RemotePushDefault(ctx)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\t// Suppressing these errors as we have other means of computing the PullRequestRefs when t