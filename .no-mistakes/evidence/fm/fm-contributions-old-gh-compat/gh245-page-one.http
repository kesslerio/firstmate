ived_events","type":"User","user_view_type":"public","site_admin":true},"body":"Need to uncomment this before merging.","created_at":"2025-02-27T18:07:05Z","updated_at":"2025-02-27T18:07:06Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1974100416","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1974100416"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1974100416"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1974100416/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":1,"side":"RIGHT","author_association":"MEMBER","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1974197883","pull_request_review_id":2648833331,"id":1974197883,"node_id":"PRRC_kwDODKw3uc51q957","diff_hunk":"@@ -0,0 +1,45 @@\n+# skip 'it creates a fork owned by the user running the test'\n+\n+# Setup environment variables used for testscript\n+env REPO=${SCRIPT_NAME}-${RANDOM_STRING}\n+env FORK=${REPO}-fork\n+\n+# Use gh as a credential helper\n+exec gh auth setup-git\n+\n+# Get the current username for the fork owner\n+exec gh api user --jq .login\n+stdout2env USER\n+\n+# Create a repository to act as upstream with a file so it has a default branch\n+exec gh repo create ${ORG}/${REPO} --add-readme --private\n+\n+# Defer repo cleanup of upstream\n+defer gh repo delete --yes ${ORG}/${REPO}\n+\n+# Create a user fork of repository. This will be owned by USER.\n+exec gh repo fork ${ORG}/${REPO} --fork-name ${FORK}\n+\n+# Defer repo cleanup of fork\n+defer gh repo delete --yes ${USER}/${FORK}\n+sleep 5\n+exec gh repo view ${USER}/${FORK} --json id --jq '.id'\n+stdout2env FORK_ID\n+\n+# Clone the repo\n+exec gh repo clone ${USER}/${FORK}\n+cd ${FORK}\n+\n+# Prepare a branch where changes are pulled from the upstream default branch but pushed to fork\n+exec git checkout -b feature-branch upstream/main\n+exec git config branch.feature-branch.pushRemote origin\n+exec git commit --allow-empty -m 'Empty Commit'\n+exec git push\n+\n+# Create the PR spanning upstream and fork repositories\n+exec gh pr create --title 'Feature Title' --body 'Feature Body'\n+stdout https://${GH_HOST}/${ORG}/${REPO}/pull/1\n+\n+# Assert that the PR was created with the correct head repository and refs\n+exec gh pr view --json headRefName,headRepository,baseRefName,isCrossRepository\n+stdout {\"baseRefName\":\"main\",\"headRefName\":\"feature-branch\",\"headRepository\":{\"id\":\"${FORK_ID}\",\"name\":\"${FORK}\"},\"isCrossRepository\":true}","path":"acceptance/testdata/pr/pr-create-respects-branch-pushremote.txtar","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"4483236d71f92abb6e5217ad8c2e8300709e838b","user":{"login":"jtmcg","id":5891697,"node_id":"MDQ6VXNlcjU4OTE2OTc=","avatar_url":"https://avatars.githubusercontent.com/u/5891697?v=4","gravatar_id":"","url":"https://api.github.com/users/jtmcg","html_url":"https://github.com/jtmcg","followers_url":"https://api.github.com/users/jtmcg/followers","following_url":"https://api.github.com/users/jtmcg/following{/other_user}","gists_url":"https://api.github.com/users/jtmcg/gists{/gist_id}","starred_url":"https://api.github.com/users/jtmcg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jtmcg/subscriptions","organizations_url":"https://api.github.com/users/jtmcg/orgs","repos_url":"https://api.github.com/users/jtmcg/repos","events_url":"https://api.github.com/users/jtmcg/events{/privacy}","received_events_url":"https://api.github.com/users/jtmcg/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"❤️ This is an excellent assertion!","created_at":"2025-02-27T19:15:08Z","updated_at":"2025-02-27T20:15:18Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1974197883","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1974197883"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1974197883"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1974197883/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":45,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":45,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1974204057","pull_request_review_id":2648833331,"id":1974204057,"node_id":"PRRC_kwDODKw3uc51q_aZ","diff_hunk":"@@ -0,0 +1,45 @@\n+# skip 'it creates a fork owned by the user running the test'\n+\n+# Setup environment variables used for testscript\n+env REPO=${SCRIPT_NAME}-${RANDOM_STRING}\n+env FORK=${REPO}-fork\n+\n+# Use gh as a credential helper\n+exec gh auth setup-git\n+\n+# Get the current username for the fork owner\n+exec gh api user --jq .login\n+stdout2env USER\n+\n+# Create a repository to act as upstream with a file so it has a default branch\n+exec gh repo create ${ORG}/${REPO} --add-readme --private\n+\n+# Defer repo cleanup of upstream\n+defer gh repo delete --yes ${ORG}/${REPO}\n+\n+# Create a user fork of repository. This will be owned by USER.\n+exec gh repo fork ${ORG}/${REPO} --fork-name ${FORK}\n+\n+# Defer repo cleanup of fork\n+defer gh repo delete --yes ${USER}/${FORK}\n+sleep 5\n+exec gh repo view ${USER}/${FORK} --json id --jq '.id'\n+stdout2env FORK_ID\n+\n+# Clone the repo\n+exec gh repo clone ${USER}/${FORK}","path":"acceptance/testdata/pr/pr-create-respects-branch-pushremote.txtar","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"4483236d71f92abb6e5217ad8c2e8300709e838b","user":{"login":"jtmcg","id":5891697,"node_id":"MDQ6VXNlcjU4OTE2OTc=","avatar_url":"https://avatars.githubusercontent.com/u/5891697?v=4","gravatar_id":"","url":"https://api.github.com/users/jtmcg","html_url":"https://github.com/jtmcg","followers_url":"https://api.github.com/users/jtmcg/followers","following_url":"https://api.github.com/users/jtmcg/following{/other_user}","gists_url":"https://api.github.com/users/jtmcg/gists{/gist_id}","starred_url":"https://api.github.com/users/jtmcg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jtmcg/subscriptions","organizations_url":"https://api.github.com/users/jtmcg/orgs","repos_url":"https://api.github.com/users/jtmcg/repos","events_url":"https://api.github.com/users/jtmcg/events{/privacy}","received_events_url":"https://api.github.com/users/jtmcg/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"My only concern with this is that both `gh repo fork` and `gh repo clone` [set `gh-resolved` in the git config](https://github.com/search?q=repo%3Acli%2Fcli+SetRemoteResolution+path%3Apkg%2Fcmd%2Frepo%2F**&type=code). There may be some logic overriding our use-case if that's set, though I'm not sure. This all should function properly without `gh-resolved` being set, so I'd want to verify that there's no intersection here.","created_at":"2025-02-27T19:20:15Z","updated_at":"2025-02-27T20:15:18Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1974204057","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1974204057"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1974204057"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https:/