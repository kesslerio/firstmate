api.github.com/users/BagToad/repos","events_url":"https://api.github.com/users/BagToad/events{/privacy}","received_events_url":"https://api.github.com/users/BagToad/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"Braindump of criteria for prompting to push:\r\n\r\n- the user did not provide the --head flag. \r\n- is the current HEAD different sha than the remote head ref\r\n- are we able to prompt\r\n- do we have a head ref?","created_at":"2025-02-27T23:02:17Z","updated_at":"2025-02-27T23:02:17Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1974467252","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1974467252"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1974467252"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1974467252/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":772,"side":"RIGHT","in_reply_to_id":1974270939,"author_association":"MEMBER","original_position":286,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983478028","pull_request_review_id":2664654277,"id":1983478028,"node_id":"PRRC_kwDODKw3uc52OXkM","diff_hunk":"@@ -0,0 +1,46 @@\n+skip 'it creates a fork owned by the user running the test'","path":"acceptance/testdata/pr/pr-create-respects-branch-pushremote.txtar","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"andyfeller","id":2089743,"node_id":"MDQ6VXNlcjIwODk3NDM=","avatar_url":"https://avatars.githubusercontent.com/u/2089743?v=4","gravatar_id":"","url":"https://api.github.com/users/andyfeller","html_url":"https://github.com/andyfeller","followers_url":"https://api.github.com/users/andyfeller/followers","following_url":"https://api.github.com/users/andyfeller/following{/other_user}","gists_url":"https://api.github.com/users/andyfeller/gists{/gist_id}","starred_url":"https://api.github.com/users/andyfeller/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andyfeller/subscriptions","organizations_url":"https://api.github.com/users/andyfeller/orgs","repos_url":"https://api.github.com/users/andyfeller/repos","events_url":"https://api.github.com/users/andyfeller/events{/privacy}","received_events_url":"https://api.github.com/users/andyfeller/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"Could you help me understand the need for skipping this acceptance test and how this relates to the acceptance testing results?\r\n\r\n_I think all of these acceptance tests are marked as skipped_ 🤔 ","created_at":"2025-03-06T14:39:06Z","updated_at":"2025-03-06T15:42:55Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983478028","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983478028"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983478028"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983478028/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1,"original_line":1,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":1,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983485574","pull_request_review_id":2664654277,"id":1983485574,"node_id":"PRRC_kwDODKw3uc52OZaG","diff_hunk":"@@ -0,0 +1,46 @@\n+skip 'it creates a fork owned by the user running the test'\n+\n+# Setup environment variables used for testscript\n+env REPO=${SCRIPT_NAME}-${RANDOM_STRING}\n+env FORK=${REPO}-fork\n+\n+# Use gh as a credential helper\n+exec gh auth setup-git\n+\n+# Get the current username for the fork owner\n+exec gh api user --jq .login\n+stdout2env USER\n+\n+# Create a repository to act as upstream with a file so it has a default branch\n+exec gh repo create ${ORG}/${REPO} --add-readme --private\n+\n+# Defer repo cleanup of upstream\n+defer gh repo delete --yes ${ORG}/${REPO}\n+\n+# Create a user fork of repository. This will be owned by USER.\n+exec gh repo fork ${ORG}/${REPO} --fork-name ${FORK}\n+\n+# Defer repo cleanup of fork\n+defer gh repo delete --yes ${USER}/${FORK}\n+sleep 5\n+exec gh repo view ${USER}/${FORK} --json id --jq '.id'\n+stdout2env FORK_ID","path":"acceptance/testdata/pr/pr-create-respects-branch-pushremote.txtar","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"andyfeller","id":2089743,"node_id":"MDQ6VXNlcjIwODk3NDM=","avatar_url":"https://avatars.githubusercontent.com/u/2089743?v=4","gravatar_id":"","url":"https://api.github.com/users/andyfeller","html_url":"https://github.com/andyfeller","followers_url":"https://api.github.com/users/andyfeller/followers","following_url":"https://api.github.com/users/andyfeller/following{/other_user}","gists_url":"https://api.github.com/users/andyfeller/gists{/gist_id}","starred_url":"https://api.github.com/users/andyfeller/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andyfeller/subscriptions","organizations_url":"https://api.github.com/users/andyfeller/orgs","repos_url":"https://api.github.com/users/andyfeller/repos","events_url":"https://api.github.com/users/andyfeller/events{/privacy}","received_events_url":"https://api.github.com/users/andyfeller/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"I'll be vulnerable and say I had a little stutter reading this until I realized there are 2 things really going on here.  Made me wonder if separating the steps would help others, too.\r\n\r\n```suggestion\r\n# Create a user fork of repository. This will be owned by USER.\r\nexec gh repo fork ${ORG}/${REPO} --fork-name ${FORK}\r\n\r\n# Defer repo cleanup of fork\r\ndefer gh repo delete --yes ${USER}/${FORK}\r\n\r\n# Retrieve fork repository information\r\nsleep 5\r\nexec gh repo view ${USER}/${FORK} --json id --jq '.id'\r\nstdout2env FORK_ID\r\n```","created_at":"2025-03-06T14:43:14Z","updated_at":"2025-03-06T15:42:55Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983485574","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983485574"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983485574"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983485574/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":20,"original_start_line":20,"start_side":"RIGHT","line":null,"original_line":29,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":27,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983494653","pull_request_review_id":2664654277,"id":1983494653,"node_id":"PRRC_kwDODKw3uc52Obn9","diff_hunk":"@@ -0,0 +1,51 @@\n+skip 'it creates a fork owned by the user running the test'\n+\n+# Setup environment variables used for testscript\n+env REPO=${SCRIPT_NAME}-${RANDOM_STRING}\n+env FORK=${REPO}-fork\n+\n+# Use gh as a credential helper\n+exec gh auth setup-git\n+\n+# Get the current username for the fork owner\n+exec gh api user --jq .login\n+stdout2env USER\n+\n+# Create a repository to act as upstream with a file so it has a default branch\n+exec gh repo create ${ORG}/${REPO} --add-readme --private\n+\n+# Defer repo cleanup of upstream\n+defer gh repo delete --yes ${ORG}/${REPO}\n+\n+# Create a user fork of repository. This will be owned by USER.\n+exec gh repo fork ${ORG}/${REPO} --fork-name ${FORK}\n+\n+# Defer repo cleanup of fork\n+defer gh repo delete --yes ${USER}/${FORK}\n+sleep 5\n+exec gh repo view ${USER}/${FORK} --json id --jq '.id'\n+stdout2env FORK_ID","path":"acceptance/testdata/pr/pr-create-respects-push-destination.txtar","commit_id":"a9dbda69135631511eebfa8173f80e93e726c7b2","original_commit_id":"dde7e24847970df859ca883ba316b4e09d039a71","user":{"login":"andyfeller","id":2089743,"node_id":"MDQ6VXNlcjIwODk3NDM=","avatar_url":"https://avatars.githubusercontent.com/u/2089743?v=4","gravatar_id":"","url":"https://api.github.com/users/andyfeller","html_url":"https://github.com/andyfeller","followers_url":"https://api.github.com/users/andyfeller/followers","following_url":"https://api.github.com/users/andyfeller/following{/other_user}","gists_url":"https://api.github.com/users/andyfeller/gists{/gist_id}","starred_url":"https://api.github.com/users/andyfeller/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andyfeller/subscriptions","organizations_url":"https://api.github.com/users/andyfeller/orgs","repos_url":"https://api.github.com/users/andyfeller/repos","events_url":"https://api.github.com/users/andyfeller/events{/privacy}","received_events_url":"https://api.github.com/users/andyfeller/received_events","type":"User","user_view_type":"public","site_admin":true},"body":"```suggestion\r\n# Defer repo cleanup of fork\r\ndefer gh repo delete --yes ${USER}/${FORK}\r\n\r\n# Retrieve fork repository information\r\nsleep 5\r\nexec gh repo view ${USER}/${FORK} --json id --jq '.id'\r\nstdout2env FORK_ID\r\n```","created_at":"2025-03-06T14:48:20Z","updated_at":"2025-03-06T15:42:55Z","html_url":"https://github.com/cli/cli/pull/10513#discussion_r1983494653","pull_request_url":"https://api.github.com/repos/cli/cli/pulls/10513","_links":{"self":{"href":"https://api.github.com/repos/cli/cli/pulls/comments/1983494653"},"html":{"href":"https://github.com/cli/cli/pull/10513#discussion_r1983494653"},"pull_request":{"href":"https://api.github.com/repos/cli/cli/pulls/10513"}},"reactions":{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983494653/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":23,"original_start_line":23,"start_side":"RIGHT","line":null,"original_line":29,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":27,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/cli/cli/pulls/comments/1983497480","pull_request_review_id":2664654277,"id":1983497480,"node_id":"PRRC_kwDODKw3uc52OcUI","diff_hunk":"@@ -0,0 +1,51 @@\n+skip 'it creates a fork owned by the user running the test'\n+\n+# Setup environment variables used for testscript\n+env REPO=${SCRIPT_NAME}-${RANDOM_STRING}\n+env FORK=${REPO}-fork\n+\n+# Use gh as a credential helper\n+exec gh auth setup-git\n+\n+# Get the current username for the fork owner\n+exec gh api user --jq .login\n+stdout2env USER\n+\n+# Create a repository to act as upstream with a file so it has a default branch\n+exec gh repo create ${ORG}/${REPO} --add-readme --private\n+\n+# Defer repo cleanup of upstream\n+defer gh repo delete --yes ${ORG}/${REPO}\n+\n+# Create a user fork of repository. This will be owned by USER.\n+exec gh repo fork ${ORG}/${REPO} --fork-name ${FORK}\n+\n+# Defer repo cleanup of fork\n+defer gh repo delete --yes ${USER}/${FORK}\n+sleep 5\n+exec gh repo view ${USER}/${FORK} --json id --jq '.id'\n+stdout2env FORK_ID\n+\n+# Clone the repo\n+exec gh repo clone ${USER}/${FORK}\n+cd ${FORK}\n+\n+# Configure default push behavior so local and remote branches will be the same\n+exec git config push.default current","path":"a