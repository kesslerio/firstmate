########## Scenario 1: one pool across the primary home and its local secondmate; a pre-pool ship counts once
$ # live launch owner pid 2221164
$ fm-fleet-seats.sh reserve r1 --generation g-r1 --kind ship --harness claude --model demo/model-a --holder-pid 2221164   (FM_HOME=primary)
fleet-seats: reserved pool=shared id=r1 generation=g-r1 used=2 capacity=2
exit=0

$ fm-fleet-seats.sh reserve a1 --generation g-a1 --kind ship --harness claude --model demo/model-a --holder-pid 2221615   (FM_HOME=android, the local secondmate)
fleet-seats: pool shared is full (2 of 2 seats held); a1 gets no seat for model demo/model-a - choose an overflow route or wait for a holder to finish
  holder /tmp/fm-seat-live.GP3Ei2/s1/primary/state legacy-agent
  holder /tmp/fm-seat-live.GP3Ei2/s1/primary/state r1
exit=4

$ fm-fleet-seats.sh release r1 --generation g-r1 --reason prelaunch   (FM_HOME=primary)
fleet-seats: released id=r1 generation=g-r1 reason=prelaunch
exit=0
$ fm-fleet-seats.sh reserve a1 ... (retry from android)
fleet-seats: reserved pool=shared id=a1 generation=g-a1 used=2 capacity=2
exit=0

$ fm-fleet-seats.sh show legacy-agent   (FM_HOME=primary, read-only)
exit=0

