[{"state_dir":"/tmp/fm-seat-live.1m3m8w/remote/state/parent-route","task":"theshop","generation":"host.1","model":"pool-model-a","lifecycle":"confirmed"}]
-- capacity 2: one seat for the supervisor, one free for a local contender
fleet-seats: reserved pool=shared id=contender generation=g-contender used=2 capacity=2
rc=0
-- the next local contender is refused: the supervisor's single seat is charged
fleet-seats: pool shared is full (2 of 2 seats held); contender-2 gets no seat for model pool-model-a - choose an overflow route or wait for a holder to finish
  holder /tmp/fm-seat-live.1m3m8w/primary/state contender
  holder /tmp/fm-seat-live.1m3m8w/primary/state theshop
rc=4
-- a pooled launch inside the remote home files its request; the root serve answers it over ssh
