-- state before pools: parent record has no generation (base-commit remote spawn format), host receipt has one
/tmp/fm-seat-live.1m3m8w/primary/state/theshop.meta:kind=secondmate
/tmp/fm-seat-live.1m3m8w/primary/state/theshop.meta:model=pool-model-a
/tmp/fm-seat-live.1m3m8w/primary/state/theshop.meta:remote_host=seatlab-remote
/tmp/fm-seat-live.1m3m8w/remote/state/parent-route/theshop.meta:kind=secondmate
/tmp/fm-seat-live.1m3m8w/remote/state/parent-route/theshop.meta:model=pool-model-a
/tmp/fm-seat-live.1m3m8w/remote/state/parent-route/theshop.meta:spawn_gen=host.1
-- the primary serves the remote through real ssh: the host supervisor is adopted into the certificate
served theshop policy=3130302336-69 epoch=r1793555430184610231606.1 holders=1
